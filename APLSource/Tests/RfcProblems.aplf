RfcProblems←{
⍝ '' if calendar text ⍵ follows the parts of RFC 5545 that matter here, else what's wrong.
    t←⍵ ⋄ p←⍬
    p,←(∨/(t=LF)>¯1⌽t=CR)/⊂'lines must end with CRLF (3.1)'
    p,←(∨/75<{≢'UTF-8'⎕UCS ⍵}¨t⊆⍨~t∊CR LF)/⊂'lines over 75 octets must be folded (3.1)'
    l←Unfold t ⋄ pr←Prop¨l ⋄ nm←⊃¨pr
    b←⍸l≡¨⊂'BEGIN:VEVENT' ⋄ e←⍸l≡¨⊂'END:VEVENT'
    ev←{pr[b[⍵]+⍳e[⍵]-b[⍵]+1]}¨⍳≢b
    Count←{+/(⊂⍺)≡¨⊃¨⍵}
    p,←(∨/{1≠'UID'Count ⍵}¨ev)/⊂'every VEVENT needs one UID (3.6.1)'
    p,←(∨/{1≠'DTSTAMP'Count ⍵}¨ev)/⊂'every VEVENT needs one DTSTAMP (3.6.1)'
    used←∪5↓¨{⍵/⍨'TZID='∘≡¨5↑¨⍵}⊃,/2⊃¨pr
    defined←3⊃¨(nm≡¨⊂'TZID')/pr
    p,←(∨/~used∊defined)/⊂'every TZID used needs a VTIMEZONE (3.2.19)'
    LocalUntil←{
        s←(⊃¨⍵)≡¨⊂'DTSTART' ⋄ r←(⊃¨⍵)≡¨⊂'RRULE'
        ~∨/r:0
        tzid←∨/∊{∨/'TZID='∘≡¨5↑¨2⊃⍵}¨s/⍵
        u←'UNTIL=[0-9T]+(Z?)'⎕S'\1'⊢3⊃⊃r/⍵
        tzid∧(0<≢u)∧u≡,⊂''        ⍝ one UNTIL, without a Z
    }
    p,←(∨/LocalUntil¨ev)/⊂'UNTIL must be in UTC when DTSTART has a TZID (3.3.10)'
    txt←3⊃¨(nm∊'SUMMARY' 'DESCRIPTION' 'LOCATION' 'COMMENT')/pr
    p,←(∨/{∨/',;\'∊'\\[\\;,nN]'⎕R''⊢⍵}¨txt)/⊂'commas, semicolons and backslashes in TEXT must be escaped (3.3.11)'
    0=≢p:''
    ⊃{⍺,'; ',⍵}/p
}
