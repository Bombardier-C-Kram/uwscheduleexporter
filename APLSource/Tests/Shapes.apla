(
  ⍝ Regexes for the other fields expected on the page (see Unrecognised).
  '^[A-Z]{2,6} \d{2,3}[A-Z]? - .+$'                                         ⍝ course header
  '^\d+(\.\d+)?$'                                                           ⍝ class nbr, section, units
  '^[A-Z]{3}$'                                                              ⍝ component
  '^(Su|Th|M|T|W|F|S)+ \d{1,2}:\d\d([AP]M)? - \d{1,2}:\d\d([AP]M)?$'        ⍝ days & times
  '^\d{1,2}/\d{1,2}/\d{4} - \d{1,2}/\d{1,2}/\d{4}$'                         ⍝ start/end dates
  '^[A-Z][A-Z0-9]{0,3} \d{3,4}[A-Z]?$'                                      ⍝ room
  '^(Spring|Fall|Winter) \d{4} \| \w+ \| University of Waterloo$'           ⍝ term
)
